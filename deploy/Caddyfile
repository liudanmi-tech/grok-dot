# 控制台与 /api（分享链接与基本认证两条入口共用）
(console) {
	handle /api/* {
		reverse_proxy backend:8100 {
			header_up X-Proxy-Auth {$PROXY_SECRET}
		}
	}
	handle {
		root * /srv/console
		try_files {path} /index.html
		file_server
	}
}

{$DOMAIN} {
	encode gzip

	# WhatsApp Webhook：对公网开放，由应用校验 Meta 签名（X-Hub-Signature-256）
	handle /webhooks/* {
		reverse_proxy backend:8100
	}

	# 分享链接：https://域名/?k=<SHARE_KEY>#/goals → 写入 30 天 Cookie 并去掉参数，之后免登录直接使用。
	# 换一个 SHARE_KEY 并重启 caddy，旧链接与旧 Cookie 立即失效。
	@share_link query k={$SHARE_KEY}
	handle @share_link {
		header Set-Cookie "ngap_share={$SHARE_KEY}; Path=/; Max-Age=2592000; HttpOnly; Secure; SameSite=Lax"
		redir {path} 302
	}

	@shared header_regexp Cookie (^|;\s*)ngap_share={$SHARE_KEY}(;|$)
	handle @shared {
		import console
	}

	# 演示期：完全公开，任何人打开链接直接用（不弹登录框）。
	# 收回权限：把下面的 import console 换回 basic_auth { {$CONSOLE_USER} {$CONSOLE_PASSWORD_HASH} } + import console，重启 caddy。
	# /internal 与 /v1（给 Hermes 用的内部接口）不对外转发。
	handle {
		import console
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}
}
