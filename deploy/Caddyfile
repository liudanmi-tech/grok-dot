{$DOMAIN} {
	encode gzip

	# WhatsApp Webhook：对公网开放，由应用校验 Meta 签名（X-Hub-Signature-256）
	handle /webhooks/* {
		reverse_proxy backend:8100
	}

	# 控制台和 /api：加基本认证。控制台目前是 POC 模拟登录，不能裸露在公网。
	# /internal 与 /v1（给 Hermes 用的内部接口）不对外转发。
	handle {
		basic_auth {
			{$CONSOLE_USER} {$CONSOLE_PASSWORD_HASH}
		}
		handle /api/* {
			reverse_proxy backend:8100 {
				header_up X-Proxy-Auth {$PROXY_SECRET}
			}
		}
		handle {
			root * /srv/console
			try_files {path} /index.html
			file_server
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}
}
