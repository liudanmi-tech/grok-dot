# 复制为 deploy/.env 后填写（不会提交到 Git）
DOMAIN=agents.example.com
POSTGRES_PASSWORD=
# 后端只信任带这个值的请求（由 Caddy 在基本认证通过后加上）；用 openssl rand -hex 24 生成
PROXY_SECRET=
CONSOLE_USER=admin
# 控制台密码的 bcrypt 哈希。生成：docker run --rm caddy:2.8-alpine caddy hash-password --plaintext '你的密码'
# 注意用单引号包住，避免 $ 被解析
CONSOLE_PASSWORD_HASH=''
# 分享链接钥匙（免登录访问）：https://域名/?k=<SHARE_KEY>#/goals ；用 openssl rand -hex 16 生成，换掉即收回所有分享
SHARE_KEY=
